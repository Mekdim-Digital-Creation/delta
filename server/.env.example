# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Storage driver ───────────────────────────────────────────────────────
# mysql = real MySQL/MariaDB (run `npm run seed` once to create the schema)
# memory = zero-config file-backed store, auto-seeded on first boot
DB_DRIVER=mysql

# ── MySQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=delta_print_house

# Used only when DB_DRIVER=memory
MEMORY_DB_FILE=./data/store.json

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=dph_dev_secret_9f4b2c8e7a1d6f3b5e0c
JWT_EXPIRES_IN=7d

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=400
